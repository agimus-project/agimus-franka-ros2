    url: https://github.com/agimus-project/agimus-msgs.git
    version: main
  src/agimus-controller:
    type: git
    url: https://github.com/agimus-project/agimus-controller.git
    version: main
  src/agimus-demos:
    type: git
    url: https://github.com/agimus-project/agimus-demos.git
    version: main
